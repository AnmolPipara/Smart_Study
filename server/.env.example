[TEMPLATE]
# ─── AI Provider Keys (at least one required) ─────────────────────────────────
# Primary provider — https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key

# Fallback 1 — https://console.groq.com (free tier)
GROQ_API_KEY=your-groq-api-key

# Fallback 2 — https://aistudio.google.com (free tier)
GEMINI_API_KEY=your-gemini-api-key

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to always return demo responses (useful for deployments where
# no live API key is configured). The UI will display a "Demo Mode" banner.
DEMO_MODE=false
